[33.642077, "o", "\r\n  \u001b[1mEmkay Home kører!\u001b[0m\r\n\r\n"]
[33.654719, "o", "  Åbn dette på din pc eller telefon:\r\n\r\n      \u001b[38;5;39m\u001b[1mhttp://192.168.1.10/\u001b[0m\r\n"]
