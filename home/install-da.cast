[33.827341, "o", "    █████████████████████████\r\n"]
[33.828767, "o", "    ██ ▄▄▄▄▄ █▀█▀ ██ ▄▄▄▄▄ ██\r\n    ██ █   █ █▄▀ ▀ █ █   █ ██\r\n    ██ █▄▄▄█ █ ▄ ▄██ █▄▄▄█ ██\r\n    ██▄▄▄▄▄▄▄█ ▀ ▀ █▄▄▄▄▄▄▄██\r\n    ██  █▄▀█▄▄▀▀▄▀▀▀▄▄ █▄▄▀██\r\n    ██▄▀▀█▄▀▄▄▀▀▀█▄▀ █▀▀▄▀ ██\r\n    ███▄▄▄▄▄▄█ █▀█ ▄█ █▄██▀██\r\n    ██ ▄▄▄▄▄ █▄▄▄  ▀██ ▄▄▄███\r\n    ██ █   █ █▀▀▄▄▀▄█  ▄█▄ ██\r\n"]
[33.831458, "o", "    ██ █▄▄▄█ █▀ ██▄██▀▄▀▄█▄██\r\n    ██▄▄▄▄▄▄▄█▄▄█▄▄▄▄████▄███\r\n    ▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀\r\n"]
[33.855847, "o", "\r\n  \u001b[38;5;245mDer vælger du sprog og adgangskode – og tilføjer din første Emkay.\u001b[0m\r\n"]
